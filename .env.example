# Plantilla de configuración privada. Copia este fichero como .env y rellena
# tus valores. .env está en .gitignore: NUNCA se sube al repositorio.

# Clave de los modelos de IA del centro (empieza por sk-).
# La usan el agente OpenCode y las órdenes «tareas ia sugerir / explicar».
CENTRO_IA_KEY=

# URL del servidor de IA del centro (acaba en /v1, sin /chat/completions).
CENTRO_IA_URL=

# En la red del instituto, si el certificado del centro no se puede validar
# con la CA (ca-simarro.crt), desactiva la verificación SOLO aquí:
# IA_TLS_VERIFICAR=0
