# Plantilla de configuración privada. Copia este fichero como .env y rellena
# tus valores. .env está en .gitignore: NUNCA se sube al repositorio.

# Clave de los modelos de IA del centro (empieza por sk-).
# La usa el agente OpenCode y, a partir de la semana 3, la orden IA de tareas.
CENTRO_IA_KEY=

# URL del servidor de IA del centro, si difiere del habitual.
CENTRO_IA_URL=
